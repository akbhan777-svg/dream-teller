568:                         }
569:                       }
570:                       router.push(&quot;/dream-teller&quot;);
571:                     }}
572:                     className=&quot;w-full bg-gradient-to-r from-dream-purple via-dream-blue to-dream-pink hover:opacity-90 text-white font-bold py-6 rounded-xl shadow-[0_0_25px_rgba(139,92,246,0.3)] transition-all flex items-center justify-center gap-2 text-base cursor-pointer&quot;
573:                   &gt;
