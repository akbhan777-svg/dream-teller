43:       .eq(&quot;payment_status&quot;, &quot;paid&quot;);
44: 
45:     const totalRevenue = paidOrders?.reduce((acc, curr) =&gt; acc + (curr.total_amount || 0), 0) || 0;
46:     const totalOrders = paidOrders?.length || 0;
47: 
48:     // 신규 유저 수 (총 유저수)
49:     const { count: newUsers } = await supabaseAdmin
50:       .from(&quot;users&quot;)
51:       .select(&quot;*&quot;, { count: &quot;exact&quot;, head: true });
52: 
53:     // 누적 AI 해석 건수
54:     const { count: aiInterpretations } = await supabaseAdmin
55:       .from(&quot;dream_results&quot;)
56:       .select(&quot;*&quot;, { count: &quot;exact&quot;, head: true })
57:       .eq(&quot;analysis_status&quot;, &quot;completed&quot;);
58: 
59:     // 월별 매출 (간이 구현: 모든 결제완료 주문 가져와서 월별 집계)
60:     const { data: allPaidOrders } = await supabaseAdmin
61:       .from(&quot;orders&quot;)
62:       .select(&quot;total_amount, created_at&quot;)
63:       .eq(&quot;payment_status&quot;, &quot;paid&quot;)
64:       .order(&quot;created_at&quot;, { ascending: true });
65: 
66:     // 최근 8개월 세팅
67:     const monthlyRevenue: { month: string; amount: number; yearMonth: string }[] = [];
68:     const now = new Date();
69:     for (let i = 7; i &gt;= 0; i--) {
70:       const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
71:       const monthStr = `${d.getMonth() + 1}월`;
72:       monthlyRevenue.push({ month: monthStr, amount: 0, yearMonth: `${d.getFullYear()}-${d.getMonth() + 1}` });
73:     }
74: 
75:     if (allPaidOrders) {
76:       allPaidOrders.forEach((order) =&gt; {
77:         const orderDate = new Date(order.created_at);
78:         const orderYearMonth = `${orderDate.getFullYear()}-${orderDate.getMonth() + 1}`;
79:         const targetMonth = monthlyRevenue.find(m =&gt; m.yearMonth === orderYearMonth);
80:         if (targetMonth) {
81:           targetMonth.amount += order.total_amount || 0;
82:         }
83:       });
84:     }
85: 
86:     return JSON.parse(JSON.stringify({
87:       success: true,
88:       data: {
89:         totalRevenue,
90:         revenueChange: &quot;+0.0%&quot;, // 임시
91:         totalOrders,
92:         orderChange: &quot;+0.0%&quot;,
93:         newUsers: newUsers || 0,
94:         userChange: &quot;+0.0%&quot;,
95:         aiInterpretations: aiInterpretations || 0,
96:         aiChange: &quot;+0.0%&quot;,
97:         monthlyRevenue
98:       }
99:     }));
