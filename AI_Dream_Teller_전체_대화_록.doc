84: 
85:       // 참고: isReinterpreting 플래그는 여기서 지우지 않고 handlePayment(결제 완료 시점)에서 지움으로써
86:       // React Strict Mode의 useEffect 2회 실행 문제나 페이지 새로고침 시에도 UX가 유지되도록 함
87:     };
88:     checkAuth();
89:   }, [supabase]);
90: 
91:   // Form State
92:   const [expert, setExpert] = useState&lt;ExpertField&gt;(null);
93:   const [dreamContent, setDreamContent] = useState(&quot;&quot;);
94:   const [includeImage, setIncludeImage] = useState(true);
95:   const [paymentOption, setPaymentOption] = useState&lt;PaymentOption&gt;(&quot;single&quot;);
96: 
97:   // 비회원 입력 정보 State
98:   const [guestPhone, setGuestPhone] = useState(&quot;&quot;);
99:   const [guestPassword, setGuestPassword] = useState(&quot;&quot;);
100:   const [showPassword, setShowPassword] = useState(false);
101:   const [isRefundConsentAgreed, setIsRefundConsentAgreed] = useState(false);
102: 
103:   // Refs for auto-scrolling
104:   const step1Ref = useRef&lt;HTMLDivElement&gt;(null);
105:   const step2Ref = useRef&lt;HTMLDivElement&gt;(null);
106:   const step3Ref = useRef&lt;HTMLDivElement&gt;(null);
107:   const step4Ref = useRef&lt;HTMLDivElement&gt;(null);
108: 
109:   const router = useRouter();
110: 
111:   // Calculate total amount
112:   const calculateTotal = () =&gt; {
113:     if (paymentOption === &quot;use_pass&quot;) return 0;
114:     if (paymentOption === &quot;pass5&quot;) return 7200;
115:     if (paymentOption === &quot;pass10&quot;) return 13500;
116:     // single
117:     return 1500 + (includeImage ? 500 : 0);
118:   };
119: 
120:   const scrollToStep = (step: Step) =&gt; {
121:     setTimeout(() =&gt; {
122:       if (step === 1 &amp;&amp; step1Ref.current) step1Ref.current.scrollIntoView({ behavior: &quot;smooth&quot;, block: &quot;center&quot; });
123:       if (step === 2 &amp;&amp; step2Ref.current) step2Ref.current.scrollIntoView({ behavior: &quot;smooth&quot;, block: &quot;center&quot; });
124:       if (step === 3 &amp;&amp; step3Ref.current) step3Ref.current.scrollIntoView({ behavior: &quot;smooth&quot;, block: &quot;center&quot; });
125:       if (step === 4 &amp;&amp; step4Ref.current) step4Ref.current.scrollIntoView({ behavior: &quot;smooth&quot;, block: &quot;center&quot; });
126:     }, 100);
127:   };
128: 
129:   const handleNextStep = (nextStep: Step) =&gt; {
130:     setActiveStep(nextStep);
131:     if (!expandAll) {
132:       scrollToStep(nextStep);
133:     }
134:   };
135: 
136:   const [showMemberOnlyModal, setShowMemberOnlyModal] = useState(false);
137: 
138:   // 결제 옵션 선택 시 비회원은 다회권(pass5, pass10) 제한 및 팝업 안내
139:   const handlePaymentOptionSelect = (option: PaymentOption) =&gt; {
140:     if (!isLoggedIn &amp;&amp; (option === &quot;pass5&quot; || option === &quot;pass10&quot;)) {
141:       setShowMemberOnlyModal(true);
142:       return;
143:     }
144:     setPaymentOption(option);
145:   };
146: 
147:   // 휴대폰 번호 하이픈 자동 포맷터
148:   const formatPhoneNumber = (value: string) =&gt; {
149:     const cleaned = value.replace(/\D/g, &quot;&quot;);
150:     if (cleaned.length &lt;= 3) return cleaned;
151:     if (cleaned.length &lt;= 7) return `${cleaned.slice(0, 3)}-${cleaned.slice(3)}`;
152:     return `${cleaned.slice(0, 3)}-${cleaned.slice(3, 7)}-${cleaned.slice(7, 11)}`;
153:   };
154: 
155:   const handlePayment = () =&gt; {
156:     if (!isLoggedIn &amp;&amp; (paymentOption === &quot;pass5&quot; || paymentOption === &quot;pass10&quot;)) {
157:       setShowMemberOnlyModal(true);
158:       return;
159:     }
160: 
161:     const amount = calculateTotal();
162:     
163:     const searchParams = new URLSearchParams({
164:       amount: amount.toString(),
165:       plan: paymentOption || &quot;single&quot;,
166:       expert: expert || &quot;&quot;,
167:       isLoggedIn: isLoggedIn.toString(),
168:       includesImage: includeImage.toString(),
169:     });
170:     
171:     if (typeof window !== &quot;undefined&quot;) {
172:       sessionStorage.setItem(&quot;dreamContent&quot;, dreamContent);
173:       if (!isLoggedIn) {
174:         sessionStorage.setItem(&quot;guestPhone&quot;, guestPhone);
175:         sessionStorage.setItem(&quot;guestPassword&quot;, guestPassword);
176:       }
177:       // 결제 단계로 넘어가면 재해석 플래그 초기화
178:       sessionStorage.removeItem(&quot;isReinterpreting&quot;);
179:     }
180: 
181:     router.push(`/payments?${searchParams.toString()}`);
182:   };
183: 
184:   const isStepOpen = (step: Step) =&gt; expandAll || activeStep === step;
185: 
186:   return (
187:     &lt;div className=&quot;w-full max-w-4xl mx-auto space-y-6 relative pb-32&quot;&gt;
188:       {/* 상단 컨트롤 영역 (모두 펼쳐보기) */}
189:       &lt;div className=&quot;flex items-center justify-end mb-4&quot;&gt;
190:         &lt;button
191:           onClick={() =&gt; setExpandAll(!expandAll)}
192:           className=&quot;text-sm text-dream-purple-light hover:text-white transition-colors flex items-center gap-2 bg-black/40 px-3 py-1.5 rounded-lg border border-white/10&quot;
193:         &gt;
194:           {expandAll ? &quot;단계별로 보기&quot; : &quot;모두 펼쳐보기&quot;}
195:           &lt;ChevronDown className={cn(&quot;w-4 h-4 transition-transform&quot;, expandAll &amp;&amp; &quot;rotate-180&quot;)} /&gt;
196:         &lt;/button&gt;
197:       &lt;/div&gt;
198: 
199:       {/* Step 1: 본인 인증 및 비회원 정보 입력 */}
200:       &lt;div 
201:         ref={step1Ref} 
202:         className={cn(
203:           &quot;rounded-2xl border transition-all duration-500 overflow-hidden&quot;, 
204:           isStepOpen(1) 
205:             ? &quot;border-dream-purple/40 bg-[#1f1f2e] shadow-[0_0_30px_rgba(139,92,246,0.15)]&quot; 
206:             : &quot;border-white/10 bg-[#161622]/85 opacity-55 hover:opacity-85 hover:border-white/20 cursor-pointer&quot;
207:         )} 
208:         onClick={() =&gt; !isStepOpen(1) &amp;&amp; setActiveStep(1)}
209:       &gt;
210:         &lt;div className=&quot;p-6 md:p-8&quot;&gt;
211:           &lt;div className=&quot;flex items-center justify-between mb-6&quot;&gt;
212:             &lt;h2 className=&quot;text-2xl font-bold text-white flex items-center gap-3&quot;&gt;
213:               &lt;span className=&quot;flex items-center justify-center w-8 h-8 rounded-full bg-dream-purple/20 text-dream-purple-light text-sm&quot;&gt;1&lt;/span&gt;
214:               본인 확인 (로그인 또는 비회원)
215:             &lt;/h2&gt;
216:             {((isLoggedIn) || (!isLoggedIn &amp;&amp; guestPhone.length &gt;= 12 &amp;&amp; guestPassword.length &gt;= 4)) &amp;&amp; !isStepOpen(1) &amp;&amp; (
217:               &lt;div className=&quot;flex items-center gap-2&quot;&gt;
218:                 &lt;span className=&quot;text-xs text-slate-300 font-normal bg-white/10 px-2.5 py-1 rounded-md border border-white/5&quot;&gt;
219:                   {isLoggedIn ? &quot;회원 인증됨&quot; : &quot;비회원 정보 입력됨&quot;}
220:                 &lt;/span&gt;
221:                 &lt;CheckCircle2 className=&quot;w-5 h-5 text-dream-blue-light&quot; /&gt;
222:                 &lt;span className=&quot;text-xs text-dream-purple-light hover:text-white transition-colors ml-1 font-semibold&quot;&gt;펼쳐보기&lt;/span&gt;
223:               &lt;/div&gt;
224:             )}
225:           &lt;/div&gt;
226:           
227:           &lt;div className={cn(&quot;transition-all duration-500 origin-top&quot;, isStepOpen(1) ? &quot;max-h-[800px] opacity-100 mt-4&quot; : &quot;max-h-0 opacity-0 overflow-hidden m-0&quot;)}&gt;
228:             {isLoggedIn ? (
229:               &lt;div className=&quot;flex flex-col items-center justify-center py-6 text-center space-y-4&quot;&gt;
230:                 &lt;div className=&quot;w-16 h-16 rounded-full bg-emerald-500/20 flex items-center justify-center mb-2&quot;&gt;
231:                   &lt;UserCheck className=&quot;w-8 h-8 text-emerald-400&quot; /&gt;
232:                 &lt;/div&gt;
233:                 &lt;div&gt;
234:                   &lt;h3 className=&quot;text-xl font-bold text-white&quot;&gt;회원 인증 완료&lt;/h3&gt;
235:                   &lt;p className=&quot;text-slate-400 text-sm mt-2&quot;&gt;안전하게 해몽을 진행하실 수 있습니다.&lt;/p&gt;
236:                 &lt;/div&gt;
237:                 &lt;Button 
238:                   onClick={(e) =&gt; {
239:                     e.stopPropagation();
240:                     handleNextStep(2);
241:                   }}
242:                   className=&quot;mt-4 bg-gradient-to-r from-dream-purple to-dream-pink text-white px-8 py-2.5 rounded-full hover:scale-105 transition-all shadow-lg&quot;
243:                 &gt;
244:                   다음 단계로
245:                 &lt;/Button&gt;
246:               &lt;/div&gt;
247:             ) : (
248:               &lt;div className=&quot;space-y-6&quot;&gt;
249:                 &lt;div className=&quot;p-5 rounded-xl border border-dream-blue/30 bg-dream-blue/10 flex flex-col sm:flex-row items-center justify-between gap-4&quot;&gt;
250:                   &lt;div&gt;
251:                     &lt;h3 className=&quot;text-lg font-bold text-white flex items-center gap-2&quot;&gt;
252:                       &lt;UserCheck className=&quot;w-5 h-5 text-dream-blue-light&quot; /&gt;
253:                       회원이신가요? (소셜 3초 간편가입 포함)
254:                     &lt;/h3&gt;
255:                     &lt;p className=&quot;text-slate-300 text-sm mt-1&quot;&gt;로그인 및 가입 시 작성 중인 데이터가 보존되며, 다회권 할인 혜택도 제공됩니다.&lt;/p&gt;
256:                   &lt;/div&gt;
257:                   &lt;Button onClick={() =&gt; router.push(&quot;/auth&quot;)} className=&quot;whitespace-nowrap bg-dream-blue hover:bg-dream-blue-light text-white font-bold&quot;&gt;
258:                     로그인 / 회원가입
259:                   &lt;/Button&gt;
260:                 &lt;/div&gt;
261: 
262:                 &lt;div className=&quot;relative flex items-center py-2&quot;&gt;
263:                   &lt;div className=&quot;flex-grow border-t border-white/10&quot;&gt;&lt;/div&gt;
264:                   &lt;span className=&quot;flex-shrink-0 mx-4 text-slate-500 text-sm&quot;&gt;또는 비회원으로 계속하기&lt;/span&gt;
265:                   &lt;div className=&quot;flex-grow border-t border-white/10&quot;&gt;&lt;/div&gt;
266:                 &lt;/div&gt;
267: 
268:                 &lt;div className=&quot;space-y-4&quot;&gt;
269:                   &lt;p className=&quot;text-xs text-slate-400&quot;&gt;
270:                     결제 및 분석 완료 후, 해몽 보고서를 다시 열어볼 때 사용할 연락처와 비밀번호를 설정해 주세요.
271:                   &lt;/p&gt;
272:                   &lt;div className=&quot;grid grid-cols-1 sm:grid-cols-2 gap-4&quot;&gt;
273:                     &lt;div className=&quot;space-y-1.5&quot;&gt;
274:                       &lt;label className=&quot;text-xs font-semibold text-slate-300 px-1 flex items-center gap-1.5&quot;&gt;&lt;Phone className=&quot;w-3.5 h-3.5 text-dream-purple-light&quot; /&gt; 전화번호&lt;/label&gt;
275:                       &lt;input
276:                         type=&quot;tel&quot;
277:                         value={guestPhone}
278:                         onChange={(e) =&gt; setGuestPhone(formatPhoneNumber(e.target.value))}
279:                         maxLength={13}
280:                         placeholder=&quot;010-1234-5678&quot;
281:                         className=&quot;w-full bg-[#13131b] text-white p-3.5 rounded-xl border border-white/20 focus:border-dream-purple focus:bg-[#0d0d12] focus:outline-none text-sm placeholder:text-slate-500 shadow-inner transition-all&quot;
282:                       /&gt;
283:                     &lt;/div&gt;
284:                     &lt;div className=&quot;space-y-1.5&quot;&gt;
285:                       &lt;label className=&quot;text-xs font-semibold text-slate-300 px-1 flex items-center gap-1.5&quot;&gt;&lt;Lock className=&quot;w-3.5 h-3.5 text-dream-purple-light&quot; /&gt; 조회용 보안 PIN (숫자 4자리)&lt;/label&gt;
286:                       &lt;div className=&quot;relative&quot;&gt;
287:                         &lt;input
288:                           type=&quot;text&quot;
289:                           inputMode=&quot;numeric&quot;
290:                           pattern=&quot;[0-9]*&quot;
291:                           maxLength={4}
292:                           name=&quot;guest-pin&quot;
293:                           autoComplete=&quot;off&quot;
294:                           data-lpignore=&quot;true&quot;
295:                           value={guestPassword}
296:                           onChange={(e) =&gt; setGuestPassword(e.target.value.replace(/\D/g, &quot;&quot;))}
297:                           placeholder=&quot;예: 8942 (숫자 4자리)&quot;
298:                           style={{ WebkitTextSecurity: showPassword ? &quot;none&quot; : &quot;disc&quot; }}
299:                           className=&quot;w-full bg-[#13131b] text-white p-3.5 rounded-xl border border-white/20 focus:border-dream-purple focus:bg-[#0d0d12] focus:outline-none text-sm placeholder:text-slate-500 pr-10 shadow-inner transition-all font-mono tracking-widest&quot;
300:                         /&gt;
301:                         &lt;button
302:                           type=&quot;button&quot;
303:                           onClick={(e) =&gt; {
304:                             e.stopPropagation();
305:                             setShowPassword(!showPassword);
306:                           }}
307:                           className=&quot;absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 transition-colors p-1&quot;
308:                         &gt;
309:                           {showPassword ? &lt;EyeOff className=&quot;w-4 h-4&quot; /&gt; : &lt;Eye className=&quot;w-4 h-4&quot; /&gt;}
310:                         &lt;/button&gt;
311:                       &lt;/div&gt;
312:                     &lt;/div&gt;
313:                   &lt;/div&gt;
314:                   
315:                   &lt;div className=&quot;flex justify-end mt-4&quot;&gt;
316:                     &lt;Button 
317:                       onClick={(e) =&gt; {
318:                         e.stopPropagation();
319:                         handleNextStep(2);
320:                       }} 
321:                       disabled={guestPhone.length &lt; 12 || guestPassword.length &lt; 4}
322:                       className={cn(
323:                         &quot;transition-all duration-300 font-semibold px-8 py-2.5 rounded-full shadow-lg border&quot;,
324:                         guestPhone.length &gt;= 12 &amp;&amp; guestPassword.length &gt;= 4
325:                           ? &quot;bg-gradient-to-r from-dream-purple to-dream-pink text-white border-white/20 hover:scale-105&quot; 
326:                           : &quot;bg-white/10 text-slate-400 border-white/10 opacity-50 cursor-not-allowed&quot;
327:                       )}
328:                     &gt;
329:                       다음 단계로
330:                     &lt;/Button&gt;
331:                   &lt;/div&gt;
332:                 &lt;/div&gt;
333:               &lt;/div&gt;
334:             )}
335:           &lt;/div&gt;
336:         &lt;/div&gt;
337:       &lt;/div&gt;
338: 
339:       {/* Step 2: 전문가 선택 */}
340:       &lt;div 
341:         ref={step2Ref} 
342:         className={cn(
343:           &quot;rounded-2xl border transition-all duration-500 overflow-hidden&quot;, 
344:           isStepOpen(2) 
345:             ? &quot;border-dream-purple/40 bg-[#1f1f2e] shadow-[0_0_30px_rgba(139,92,246,0.15)]&quot; 
346:             : &quot;border-white/10 bg-[#161622]/85 opacity-55 hover:opacity-85 hover:border-white/20 cursor-pointer&quot;,
347:           activeStep &lt; 2 &amp;&amp; !expandAll &amp;&amp; &quot;hidden&quot;
348:         )} 
349:         onClick={() =&gt; !isStepOpen(2) &amp;&amp; activeStep &gt;= 2 &amp;&amp; setActiveStep(2)}
350:       &gt;
351:         &lt;div className=&quot;p-6 md:p-8&quot;&gt;
352:           &lt;div className=&quot;flex items-center justify-between mb-6&quot;&gt;
353:             &lt;h2 className=&quot;text-2xl font-bold text-white flex items-center gap-3&quot;&gt;
354:               &lt;span className=&quot;flex items-center justify-center w-8 h-8 rounded-full bg-dream-purple/20 text-dream-purple-light text-sm&quot;&gt;2&lt;/span&gt;
355:               원하는 해몽 관점을 선택하세요
356:             &lt;/h2&gt;
357:             {expert &amp;&amp; !isStepOpen(2) &amp;&amp; (
358:               &lt;div className=&quot;flex items-center gap-2&quot;&gt;
359:                 &lt;span className=&quot;text-xs text-slate-300 font-normal bg-white/10 px-2.5 py-1 rounded-md border border-white/5&quot;&gt;
360:                   {EXPERTS.find(e =&gt; e.id === expert)?.name || &quot;&quot;}
361:                 &lt;/span&gt;
362:                 &lt;CheckCircle2 className=&quot;w-5 h-5 text-dream-blue-light&quot; /&gt;
363:                 &lt;span className=&quot;text-xs text-dream-purple-light hover:text-white transition-colors ml-1 font-semibold&quot;&gt;펼쳐보기&lt;/span&gt;
364:               &lt;/div&gt;
365:             )}
366:           &lt;/div&gt;
367:           
368:           &lt;div className={cn(&quot;grid grid-cols-1 sm:grid-cols-2 gap-4 transition-all duration-500 origin-top&quot;, isStepOpen(2) ? &quot;max-h-[800px] opacity-100 mt-4&quot; : &quot;max-h-0 opacity-0 overflow-hidden m-0&quot;)}&gt;
369:             {EXPERTS.map((exp) =&gt; (
370:               &lt;button
371:                 key={exp.id}
372:                 onClick={(e) =&gt; {
373:                   e.stopPropagation();
374:                   setExpert(exp.id as ExpertField);
375:                   setTimeout(() =&gt; handleNextStep(3), 300);
376:                 }}
377:                 className={cn(
378:                   &quot;flex flex-col items-start p-6 rounded-xl border text-left transition-all duration-300 relative overflow-hidden group cursor-pointer&quot;,
379:                   expert === exp.id
380:                     ? &quot;border-dream-blue bg-dream-blue/20 shadow-[0_0_20px_rgba(139,92,246,0.25)]&quot;
381:                     : &quot;border-white/20 bg-[#13131b] hover:bg-[#1a1a24] hover:border-white/30&quot;
382:                 )}
383:               &gt;
384:                 &lt;div className={cn(&quot;absolute inset-0 bg-gradient-to-br from-dream-purple/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity&quot;, expert === exp.id &amp;&amp; &quot;opacity-100&quot;)} /&gt;
385:                 &lt;exp.icon className={cn(&quot;w-8 h-8 mb-4 relative z-10&quot;, expert === exp.id ? &quot;text-dream-blue-light&quot; : &quot;text-slate-400&quot;)} /&gt;
386:                 &lt;h3 className=&quot;text-xl font-bold text-white mb-2 relative z-10&quot;&gt;{exp.name}&lt;/h3&gt;
387:                 &lt;p className=&quot;text-slate-400 text-sm relative z-10&quot;&gt;{exp.desc}&lt;/p&gt;
388:               &lt;/button&gt;
389:             ))}
390:           &lt;/div&gt;
391:         &lt;/div&gt;
392:       &lt;/div&gt;
393: 
394:       {/* Step 3: 꿈 내용 입력 */}
395:       &lt;div 
396:         ref={step3Ref} 
397:         className={cn(
398:           &quot;rounded-2xl border transition-all duration-500 overflow-hidden&quot;, 
399:           isStepOpen(3) 
400:             ? &quot;border-dream-purple/40 bg-[#1f1f2e] shadow-[0_0_30px_rgba(139,92,246,0.15)]&quot; 
401:             : &quot;border-white/10 bg-[#161622]/85 opacity-55 hover:opacity-85 hover:border-white/20 cursor-pointer&quot;,
402:           activeStep &lt; 3 &amp;&amp; !expandAll &amp;&amp; &quot;hidden&quot;
403:         )} 
404:         onClick={() =&gt; !isStepOpen(3) &amp;&amp; activeStep &gt;= 3 &amp;&amp; setActiveStep(3)}
405:       &gt;
406:         &lt;div className=&quot;p-6 md:p-8&quot;&gt;
407:           &lt;div className=&quot;flex items-center justify-between mb-6&quot;&gt;
408:             &lt;h2 className=&quot;text-2xl font-bold text-white flex items-center gap-3&quot;&gt;
409:               &lt;span className=&quot;flex items-center justify-center w-8 h-8 rounded-full bg-dream-purple/20 text-dream-purple-light text-sm&quot;&gt;3&lt;/span&gt;
410:               어떤 꿈을 꾸셨나요?
411:             &lt;/h2&gt;
412:             {dreamContent.trim().length &gt;= 20 &amp;&amp; !isStepOpen(3) &amp;&amp; (
413:               &lt;div className=&quot;flex items-center gap-2&quot;&gt;
414:                 &lt;CheckCircle2 className=&quot;w-5 h-5 text-dream-blue-light&quot; /&gt;
415:                 &lt;span className=&quot;text-xs text-dream-purple-light hover:text-white transition-colors ml-1 font-semibold&quot;&gt;펼쳐보기&lt;/span&gt;
416:               &lt;/div&gt;
417:             )}
418:           &lt;/div&gt;
419:           
420:           &lt;div className={cn(&quot;transition-all duration-500 origin-top&quot;, isStepOpen(3) ? &quot;max-h-[800px] opacity-100 mt-4&quot; : &quot;max-h-0 opacity-0 overflow-hidden m-0&quot;)}&gt;
421:             &lt;div className=&quot;relative group&quot;&gt;
422:               &lt;div className=&quot;absolute -inset-0.5 bg-gradient-to-r from-dream-pink via-dream-purple to-dream-blue rounded-xl blur opacity-25 group-focus-within:opacity-60 transition duration-1000 group-focus-within:duration-200&quot; /&gt;
423:               &lt;textarea
424:                 value={dreamContent}
425:                 onChange={(e) =&gt; setDreamContent(e.target.value)}
426:                 placeholder=&quot;꿈의 배경, 등장인물, 느꼈던 감정 등을 상세히 적어주시면 더 정확한 분석이 가능합니다. (최소 20자 이상)&quot;
