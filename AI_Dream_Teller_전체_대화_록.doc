106: export async function getAdminOrders(page = 1, limit = 20, status = &quot;all&quot;) {
107:   const adminCheck = await checkAdminRole();
108:   if (!adminCheck.isAdmin) return { error: &quot;Unauthorized&quot; };
109: 
110:   const supabaseAdmin = createSupabaseClient(
