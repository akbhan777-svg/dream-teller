64:         console.error(&quot;세션 획득 에러:&quot;, err);
65:       } finally {
66:         setLoading(false);
67:       }
68:     };
69:     getSession();
70: 
71:     const { data: { subscription } } = supabase.auth.onAuthStateChange(async (_event, session) =&gt; {
72:       const currentUser = session?.user ?? null;
73:       setUser(currentUser);
74:       await checkUserRole(currentUser);
75:       setLoading(false);
76:     });
77: 
78:     return () =&gt; {
79:       subscription.unsubscribe();
80:     };
81:   }, [supabase]);
82: 
