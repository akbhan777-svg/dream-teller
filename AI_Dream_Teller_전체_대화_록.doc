541:                       {isCopied ? &quot;복사완료&quot; : &quot;링크 복사&quot;}
542:                     &lt;/Button&gt;
543:                     
544:                     &lt;Button 
545:                       onClick={handleKakaoShare}
546:                       className=&quot;flex-1 sm:flex-none bg-[#FEE500] hover:bg-[#FEE500]/90 text-black font-semibold rounded-xl py-6 px-6 shadow-[0_0_20px_rgba(254,229,0,0.2)]&quot;
547:                     &gt;
548:                       &lt;Share2 className=&quot;w-4 h-4 mr-2&quot; /&gt;
549:                       카카오톡 공유
550:                     &lt;/Button&gt;
551:                   &lt;/div&gt;
552:                 &lt;/div&gt;
