471:                           {parts.map((part: string, i: number) =&gt; {
472:                             if (part.startsWith(&apos;**&apos;) &amp;&amp; part.endsWith(&apos;**&apos;)) {
473:                               return &lt;strong key={i} className=&quot;text-white font-bold bg-white/5 px-1.5 py-0.5 rounded text-dream-blue-light&quot;&gt;{part.slice(2, -2)}&lt;/strong&gt;;
474:                             }
