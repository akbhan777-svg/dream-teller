132:       .order(&quot;created_at&quot;, { ascending: false })
133:       .range(from, to);
134: 
135:     if (error) throw error;
136: 
137:     const ordersList = data || [];
138:     const userIds = Array.from(new Set(ordersList.map((o: any) =&gt; o.user_id).filter((id: string) =&gt; id &amp;&amp; id !== &quot;00000000-0000-0000-0000-000000000000&quot;)));
139: 
140:     const snapshotMap: Record&lt;string, number&gt; = {};
141: 
142:     if (userIds.length &gt; 0) {
143:       const { data: transactions } = await supabaseAdmin
144:         .from(&quot;pass_transactions&quot;)
145:         .select(&quot;user_id, order_id, amount, created_at, id&quot;)
146:         .in(&quot;user_id&quot;, userIds)
147:         .order(&quot;created_at&quot;, { ascending: true })
148:         .order(&quot;id&quot;, { ascending: true });
149: 
150:       if (transactions) {
151:         const userBalances: Record&lt;string, number&gt; = {};
152:         transactions.forEach((pt: any) =&gt; {
153:           const uid = pt.user_id;
154:           userBalances[uid] = (userBalances[uid] || 0) + (pt.amount || 0);
155:           if (pt.order_id) {
156:             snapshotMap[pt.order_id] = userBalances[uid];
157:           }
158:         });
159:       }
160:     }
161: 
162:     const ordersWithSnapshot = ordersList.map((o: any) =&gt; ({
163:       ...o,
164:       snapshot_remaining: snapshotMap[o.id] !== undefined ? snapshotMap[o.id] : o.users?.remaining_interprets
165:     }));
166: 
167:     return JSON.parse(JSON.stringify({
168:       success: true,
169:       data: ordersWithSnapshot,
170:       count
171:     }));
172:   } catch (error: any) {
173:     return { error: error.message || &quot;Failed to fetch orders&quot; };
174:   }
175: }
