28: // 1. 관리자 메트릭스 조회 (대시보드용)
29: export async function getAdminMetrics() {
30:   const adminCheck = await checkAdminRole();
31:   if (!adminCheck.isAdmin) return { error: &quot;Unauthorized&quot; };
32: 
33:   const supabaseAdmin = createSupabaseClient(
34:     process.env.NEXT_PUBLIC_SUPABASE_URL!,
35:     process.env.SUPABASE_SERVICE_ROLE_KEY!
36:   );
