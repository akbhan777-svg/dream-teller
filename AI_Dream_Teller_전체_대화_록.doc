425:                         className=&quot;bg-white/10 hover:bg-white/20 text-white font-medium text-xs py-2.5 px-4 rounded-xl border border-white/15 flex items-center gap-2 transition-all shadow-md active:scale-95 cursor-pointer&quot;
426:                       &gt;
427:                         &lt;Download className=&quot;w-4 h-4 text-dream-pink-light&quot; /&gt;
428:                         &lt;span&gt;AI 아트워크 이미지 저장&lt;/span&gt;
429:                       &lt;/Button&gt;
430:                     &lt;/div&gt;
431:                   &lt;/section&gt;
432:                 )}
433: 
434:                 &lt;section&gt;
435:                   &lt;div className=&quot;flex items-center gap-2 mb-4 px-1&quot;&gt;
436:                     &lt;div className=&quot;w-2 h-8 bg-gradient-to-b from-dream-purple to-dream-pink rounded-full&quot; /&gt;
437:                     &lt;h2 className=&quot;text-xl md:text-2xl font-bold text-white&quot;&gt;{analysisTitle}&lt;/h2&gt;
438:                   &lt;/div&gt;
