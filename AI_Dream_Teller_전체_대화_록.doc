51:     &quot;어젯밤 당신이 꾸었던 꿈의 심리 기제를 파악하는 중입니다...&quot;,
52:     &quot;선택하신 전문 관점으로 무의식의 억압된 상징을 정밀 해독 중입니다...&quot;,
53:     &quot;AI 시각화 이미지 및 무의식 심층 해몽 리포트를 생성 중입니다...&quot;,
54:     &quot;거의 다 완성되었습니다! 영혼의 문맥을 가다듬는 중입니다...&quot;
55:   ];
56: 
57:   // 1. DB 실시간 데이터 조회 및 5초 폴링 (분석 진행 중일 때)
58:   useEffect(() =&gt; {
59:     // 이미 완료되었거나 권한이 없으면 폴링 불필요
60:     if (isForbidden || (resultData &amp;&amp; resultData.analysis_status === &quot;completed&quot;)) {
61:       return;
62:     }
63: 
64:     let intervalId: NodeJS.Timeout;
65: 
66:     const fetchOrderAndResult = async () =&gt; {
67:       try {
68:         const { data: { user } } = await supabase.auth.getUser();
69:         const { order: serverOrder } = await fetchOrderAndResultBypass(orderId, user?.id);
70: 
71:         if (!serverOrder) {
72:           setIsForbidden(true);
73:           return;
74:         }
75: 
76:         if (unauthorizedQuery) {
77:           setIsForbidden(true);
78:           return;
79:         }
80: 
81:         setIsForbidden(false);
82:         setOrderData(serverOrder);
83:         const resultObj = Array.isArray(serverOrder.dream_results) ? serverOrder.dream_results[0] : serverOrder.dream_results;
84:         setResultData(resultObj);
85: 
86:         if (resultObj) {
87:           setIsPublic(Boolean(resultObj.is_public));
88:         }
89: 
90:         // 분석이 완료되었으면 폴링 중단
91:         if (resultObj &amp;&amp; resultObj.analysis_status === &quot;completed&quot;) {
92:           if (intervalId) clearInterval(intervalId);
93:         }
94:       } catch (err) {
95:         console.error(&quot;해몽 데이터 조회 에러:&quot;, err);
96:       }
97:     };
98: 
99:     // 분석 진행 중이면 5초마다 폴링으로 상태 감지
100:     intervalId = setInterval(() =&gt; {
101:       fetchOrderAndResult();
102:     }, 5000);
103: 
104:     return () =&gt; {
105:       if (intervalId) clearInterval(intervalId);
106:     };
107:   }, [orderId, supabase, unauthorizedQuery, resultData?.analysis_status, isForbidden]);
108: 
109:   // 로딩 멘트 순환 롤링 타이머
110:   useEffect(() =&gt; {
111:     if (resultData?.analysis_status === &quot;completed&quot;) return;
112:     const timer = setInterval(() =&gt; {
113:       setAnalyzingStep((prev) =&gt; (prev + 1) % analyzingMessages.length);
114:     }, 4000);
115:     return () =&gt; clearInterval(timer);
116:   }, [analyzingMessages.length, resultData?.analysis_status]);
117: 
118:   // 카카오 SDK 초기화
119:   useEffect(() =&gt; {
120:     const KAKAO_KEY = process.env.NEXT_PUBLIC_KAKAO_APP_KEY || &quot;YOUR_DUMMY_KAKAO_KEY&quot;;
121:     if (typeof window !== &quot;undefined&quot; &amp;&amp; window.Kakao) {
122:       if (!window.Kakao.isInitialized()) {
123:         try {
124:           window.Kakao.init(KAKAO_KEY);
125:         } catch (e) {
126:           console.error(&quot;Kakao SDK 초기화 실패:&quot;, e);
127:         }
128:       }
129:     }
130:   }, []);
131: 
132:   const handleCopyLink = async () =&gt; {
133:     try {
134:       await navigator.clipboard.writeText(window.location.href);
135:       setIsCopied(true);
136:       setTimeout(() =&gt; setIsCopied(false), 2000);
137:     } catch (err) {
138:       alert(&quot;링크 복사에 실패했습니다.&quot;);
139:     }
140:   };
141: 
142:   const handleKakaoShare = () =&gt; {
143:     if (typeof window !== &quot;undefined&quot; &amp;&amp; window.Kakao &amp;&amp; window.Kakao.isInitialized()) {
144:       window.Kakao.Share.sendDefault({
145:         objectType: &quot;feed&quot;,
146:         content: {
147:           title: &quot;Dream Teller - 나의 꿈 해몽 결과&quot;,
148:           description: orderData?.dream_content || &quot;나의 꿈 해몽 리포트&quot;,
149:           imageUrl: resultData?.image_url || &quot;https://picsum.photos/seed/whale/800/600&quot;,
150:           link: {
151:             mobileWebUrl: window.location.href,
152:             webUrl: window.location.href,
153:           },
154:         },
155:         buttons: [
156:           {
157:             title: &quot;해몽 결과 보기&quot;,
158:             link: {
159:               mobileWebUrl: window.location.href,
160:               webUrl: window.location.href,
161:             },
162:           },
163:         ],
164:       });
165:     } else {
166:       if (navigator.share) {
167:         navigator.share({
168:           title: &quot;Dream Teller - 나의 꿈 해몽 결과&quot;,
169:           url: window.location.href,
170:         }).catch(console.error);
171:       } else {
172:         alert(&quot;링크 복사 기능을 이용해 주세요.&quot;);
173:       }
174:     }
175:   };
176: 
177:   const handleDownloadImage = async () =&gt; {
178:     if (!resultData?.image_url) return;
179:     try {
180:       const proxyUrl = `/api/proxy-image?url=${encodeURIComponent(resultData.image_url)}`;
181:       const response = await fetch(proxyUrl);
182:       
183:       if (!response.ok) throw new Error(&quot;Proxy download failed&quot;);
184: 
185:       const blob = await response.blob();
186:       
187:       const img = new window.Image();
188:       const objectUrl = URL.createObjectURL(blob);
189:       
190:       img.onload = () =&gt; {
191:         const canvas = document.createElement(&quot;canvas&quot;);
192:         const scaleFactor = 2;
193:         canvas.width = img.width * scaleFactor;
194:         canvas.height = img.height * scaleFactor;
195:         
196:         const ctx = canvas.getContext(&quot;2d&quot;);
197:         if (ctx) {
198:           ctx.imageSmoothingEnabled = true;
199:           ctx.imageSmoothingQuality = &quot;high&quot;;
200:           ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
201:           
202:           canvas.toBlob((pngBlob) =&gt; {
203:             if (!pngBlob) return;
204:             const downloadUrl = URL.createObjectURL(pngBlob);
205:             const link = document.createElement(&quot;a&quot;);
206:             link.href = downloadUrl;
207:             link.download = `dream_art_${orderId.slice(-6)}_hd.png`;
208:             document.body.appendChild(link);
209:             link.click();
210:             document.body.removeChild(link);
211:             URL.revokeObjectURL(downloadUrl);
212:             URL.revokeObjectURL(objectUrl);
213:           }, &quot;image/png&quot;, 1.0);
214:         }
215:       };
216:       img.src = objectUrl;
217:     } catch (err) {
218:       console.error(&quot;Download error:&quot;, err);
219:       window.open(resultData.image_url, &quot;_blank&quot;);
220:     }
221:   };
222: 
223:   const handleTogglePublic = async (newVal: boolean) =&gt; {
224:     if (!resultData?.id || isTogglingPublic) return;
225:     setIsTogglingPublic(true);
226:     try {
227:       const res = await toggleDreamPublicAction(resultData.id, newVal);
228:       if (res.success) {
229:         setIsPublic(newVal);
230:         alert(newVal ? &quot;해몽 결과가 피드에 공개되었습니다! 🎉&quot; : &quot;해몽 결과가 비공개로 전환되었습니다.&quot;);
231:       } else {
232:         alert(&quot;상태 변경에 실패했습니다: &quot; + (res.error || &quot;권한 오류&quot;));
233:         setIsPublic(!newVal); // Rollback
234:       }
235:     } catch (err) {
236:       alert(&quot;오류가 발생했습니다.&quot;);
237:       setIsPublic(!newVal);
238:     } finally {
239:       setIsTogglingPublic(false);
240:     }
241:   };
242: 
243:   if (isForbidden) {
244:     return (
245:       &lt;main className=&quot;min-h-screen bg-background relative pt-24 pb-20 overflow-hidden flex items-center justify-center&quot;&gt;
246:         &lt;div className=&quot;container relative z-10 px-4 md:px-6 mx-auto max-w-md text-center&quot;&gt;
247:           &lt;div className=&quot;bg-[#18181b]/90 backdrop-blur-2xl border border-red-500/20 rounded-[2rem] p-8 shadow-2xl space-y-6&quot;&gt;
248:             &lt;div className=&quot;w-16 h-16 bg-red-500/10 rounded-full flex items-center justify-center mx-auto border border-red-500/20&quot;&gt;
249:               &lt;ShieldAlert className=&quot;w-8 h-8 text-red-400&quot; /&gt;
250:             &lt;/div&gt;
251:             &lt;div&gt;
252:               &lt;h1 className=&quot;text-2xl font-bold text-white mb-2&quot;&gt;접근 권한이 없습니다&lt;/h1&gt;
253:               &lt;p className=&quot;text-slate-400 text-sm leading-relaxed mb-4&quot;&gt;
254:                 해당 꿈 해석 리포트의 열람 권한이 없거나 존재하지 않는 주문입니다.&lt;br /&gt;본인의 계정으로 로그인 또는 조회를 진행해 주세요.
255:               &lt;/p&gt;
256:             &lt;/div&gt;
257:             &lt;div className=&quot;pt-2 flex flex-col gap-3&quot;&gt;
258:               &lt;Button 
259:                 onClick={() =&gt; router.push(&quot;/&quot;)}
260:                 className=&quot;w-full bg-gradient-to-r from-dream-purple to-dream-pink text-white font-semibold py-6 rounded-xl&quot;
261:               &gt;
262:                 메인 페이지로 이동
263:               &lt;/Button&gt;
264:               &lt;Button 
265:                 variant=&quot;outline&quot;
266:                 onClick={async () =&gt; {
267:                   const { data: { user } } = await supabase.auth.getUser();
268:                   if (user) {
269:                     router.push(&quot;/my-page&quot;);
270:                   } else {
271:                     router.push(&quot;/guest-login&quot;);
272:                   }
273:                 }}
274:                 className=&quot;w-full border-white/20 text-slate-300 py-6 rounded-xl&quot;
275:               &gt;
276:                 내역/마이페이지로 이동하기
277:               &lt;/Button&gt;
278:             &lt;/div&gt;
279:           &lt;/div&gt;
280:         &lt;/div&gt;
281:       &lt;/main&gt;
282:     );
283:   }
284: 
285:   const isCompleted = resultData &amp;&amp; resultData.analysis_status === &quot;completed&quot;;
286:   const dreamInput = orderData?.dream_content || &quot;작성된 꿈 내용이 없습니다.&quot;;
287:   const expertNameMap: Record&lt;string, string&gt; = {
288:     freud: &quot;프로이트&quot;,
289:     jung: &quot;칼 융&quot;,
290:     neuroscience: &quot;신경과학&quot;,
291:     gestalt: &quot;게슈탈트&quot;
292:   };
293:   const expertName = expertNameMap[orderData?.expert_field] || &quot;전문가&quot;;
294: 
295:   const analysisTitle = resultData?.analysis_title || `${expertName} 관점 무의식 심층 해몽`;
296:   const analysisContent = resultData?.analysis_text || 
297:     `현재 LLM 인공지능이 ${expertName} 관점으로 당신의 꿈을 심층 해독하고 있습니다.\n\n해몽 리포트 생성이 완료되면 이 페이지가 자동으로 업데이트됩니다.`;
298: 
299:   return (
300:     &lt;main className=&quot;min-h-screen bg-background relative pt-24 pb-20 overflow-hidden&quot;&gt;
301:       &lt;div className=&quot;absolute top-0 left-0 w-full h-full pointer-events-none overflow-hidden&quot;&gt;
302:         &lt;div className=&quot;absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] bg-dream-purple/10 rounded-full blur-[120px]&quot; /&gt;
303:         &lt;div className=&quot;absolute bottom-[-10%] right-[-10%] w-[50vw] h-[50vw] bg-dream-blue/10 rounded-full blur-[120px]&quot; /&gt;
304:       &lt;/div&gt;
305: 
306:       &lt;div className=&quot;container relative z-10 px-4 md:px-6 mx-auto max-w-3xl&quot;&gt;
307:         {!isCompleted ? (
308:           &lt;div className=&quot;relative animate-in fade-in duration-700&quot;&gt;
309:             &lt;div className=&quot;absolute -inset-1 bg-gradient-to-r from-dream-purple via-dream-blue to-dream-pink rounded-[2.5rem] blur-xl opacity-40 animate-pulse&quot; /&gt;
310:             
311:             &lt;div className=&quot;relative bg-[#18181b]/95 backdrop-blur-2xl border border-dream-purple/30 rounded-[2rem] p-8 md:p-12 text-center shadow-2xl space-y-8&quot;&gt;
312:               
313:               &lt;div className=&quot;relative w-28 h-28 mx-auto flex items-center justify-center&quot;&gt;
314:                 &lt;div className=&quot;absolute inset-0 rounded-full border-4 border-dream-purple/20 border-t-dream-pink animate-spin&quot; /&gt;
315:                 &lt;div className=&quot;w-20 h-20 bg-gradient-to-tr from-dream-purple to-dream-pink rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(236,72,153,0.3)]&quot;&gt;
316:                   &lt;Brain className=&quot;w-10 h-10 text-white animate-pulse&quot; /&gt;
317:                 &lt;/div&gt;
318:               &lt;/div&gt;
319: 
320:               &lt;div className=&quot;space-y-3&quot;&gt;
321:                 &lt;div className=&quot;inline-flex items-center gap-2 bg-dream-purple/20 text-dream-pink-light border border-dream-purple/40 px-4 py-1.5 rounded-full text-xs font-bold animate-pulse&quot;&gt;
322:                   &lt;Sparkles className=&quot;w-3.5 h-3.5&quot; /&gt;
323:                   &lt;span&gt;AI 무의식 심층 해몽 분석 중&lt;/span&gt;
324:                 &lt;/div&gt;
325:                 &lt;h1 className=&quot;text-2xl md:text-3xl font-bold text-white tracking-tight&quot;&gt;
326:                   {expertName} 관점으로 꿈을 분석하고 있습니다
327:                 &lt;/h1&gt;
328:                 &lt;p className=&quot;text-slate-300 text-sm max-w-md mx-auto h-12 flex items-center justify-center transition-all duration-500&quot;&gt;
329:                   {analyzingMessages[analyzingStep]}
330:                 &lt;/p&gt;
331:               &lt;/div&gt;
332: 
333:               &lt;div className=&quot;bg-white/5 border border-white/10 p-5 rounded-2xl text-left space-y-2&quot;&gt;
334:                 &lt;div className=&quot;flex items-center justify-between text-xs text-slate-400&quot;&gt;
335:                   &lt;span&gt;분석 대상 꿈 내용&lt;/span&gt;
336:                   &lt;span className=&quot;text-dream-purple-light font-medium&quot;&gt;{expertName} 선택됨&lt;/span&gt;
337:                 &lt;/div&gt;
338:                 &lt;p className=&quot;text-sm text-slate-200 line-clamp-2 italic&quot;&gt;&quot;{dreamInput}&quot;&lt;/p&gt;
339:               &lt;/div&gt;
340: 
341:               &lt;div className=&quot;p-5 rounded-2xl bg-black/40 border border-white/10 text-left space-y-4&quot;&gt;
342:                 &lt;div className=&quot;flex items-start gap-3 text-xs text-slate-300 leading-relaxed&quot;&gt;
343:                   &lt;Clock className=&quot;w-5 h-5 text-dream-blue-light shrink-0 mt-0.5&quot; /&gt;
344:                   &lt;div&gt;
345:                     &lt;p className=&quot;font-bold text-white mb-1&quot;&gt;💡 편안하게 대기해 주세요 (약 1~3분 소요)&lt;/p&gt;
346:                     &lt;p className=&quot;text-slate-400&quot;&gt;
347:                       이 창을 열어두시면 분석이 완료되는 즉시 완성된 리포트로 자동 전환됩니다. 기다리지 않고 마이페이지로 이동하셔도 백그라운드에서 안전하게 해몽이 생성되며, 마이페이지에서 언제든지 결과를 확인하실 수 있습니다.
348:                     &lt;/p&gt;
349:                   &lt;/div&gt;
350:                 &lt;/div&gt;
351: 
352:                 &lt;div className=&quot;flex flex-col sm:flex-row gap-3 pt-2&quot;&gt;
353:                   &lt;Button
354:                     onClick={async () =&gt; {
355:                       const { data: { user } } = await supabase.auth.getUser();
356:                       if (user) {
357:                         router.push(&quot;/my-page&quot;);
358:                       } else {
359:                         const gp = sessionStorage.getItem(&quot;guestPhone&quot;);
360:                         const gpw = sessionStorage.getItem(&quot;guestPassword&quot;);
361:                         if (gp &amp;&amp; gpw) {
362:                           sessionStorage.setItem(&quot;guestLoginPhone&quot;, gp);
363:                           sessionStorage.setItem(&quot;guestLoginPassword&quot;, gpw);
364:                           router.push(&quot;/guest-check&quot;);
365:                         } else {
366:                           router.push(&quot;/guest-login&quot;);
367:                         }
368:                       }
369:                     }}
370:                     className=&quot;w-full bg-gradient-to-r from-dream-purple to-dream-pink text-white font-bold py-6 rounded-xl shadow-lg hover:opacity-90 transition-opacity flex items-center justify-center gap-2&quot;
371:                   &gt;
372:                     &lt;span&gt;마이페이지에서 대기하기&lt;/span&gt; &lt;ArrowRight className=&quot;w-4 h-4&quot; /&gt;
373:                   &lt;/Button&gt;
374:                 &lt;/div&gt;
375:               &lt;/div&gt;
376: 
377:             &lt;/div&gt;
378:           &lt;/div&gt;
379:         ) : (
380:           &lt;div className=&quot;relative animate-in fade-in duration-700&quot;&gt;
381:             &lt;div className=&quot;absolute -inset-1 bg-gradient-to-br from-orange-100/20 via-dream-purple/30 to-dream-pink/20 rounded-[2.5rem] blur-xl opacity-70&quot; /&gt;
382:             
383:             &lt;div className=&quot;relative bg-[#18181b]/90 backdrop-blur-2xl border border-white/10 rounded-[2rem] overflow-hidden shadow-2xl&quot;&gt;
384:               
385:               &lt;div className=&quot;p-8 md:p-10 text-center border-b border-white/5 relative overflow-hidden&quot;&gt;
386:                 &lt;div className=&quot;absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1/2 bg-dream-pink/20 blur-[80px] rounded-full&quot; /&gt;
387:                 &lt;Sparkles className=&quot;w-8 h-8 text-dream-pink mx-auto mb-4 relative z-10&quot; /&gt;
388:                 &lt;h1 className=&quot;text-2xl md:text-3xl font-bold text-white mb-2 relative z-10&quot;&gt;당신의 꿈 해석이 완료되었습니다&lt;/h1&gt;
389:                 &lt;p className=&quot;text-slate-400 text-sm font-mono relative z-10&quot;&gt;Order ID: {orderData?.order_number || orderId}&lt;/p&gt;
390:               &lt;/div&gt;
391: 
392:               &lt;div className=&quot;p-6 md:p-10 space-y-12&quot;&gt;
393:                 
394:                 &lt;section className=&quot;relative&quot;&gt;
395:                   &lt;Quote className=&quot;absolute -top-4 -left-4 w-12 h-12 text-white/5 rotate-180&quot; /&gt;
396:                   &lt;div className=&quot;relative z-10 p-6 bg-white/5 rounded-2xl border border-white/10&quot;&gt;
397:                     &lt;h3 className=&quot;text-xs font-semibold text-dream-purple-light uppercase tracking-wider mb-3&quot;&gt;어젯밤 당신의 꿈&lt;/h3&gt;
398:                     &lt;p className=&quot;text-lg md:text-xl font-medium text-slate-200 leading-relaxed italic&quot;&gt;
399:                       &quot;{dreamInput}&quot;
400:                     &lt;/p&gt;
401:                   &lt;/div&gt;
402:                 &lt;/section&gt;
403: 
404:                 {resultData?.image_url &amp;&amp; (
405:                   &lt;section className=&quot;space-y-3&quot;&gt;
406:                     &lt;h3 className=&quot;text-xs font-semibold text-dream-blue-light uppercase tracking-wider px-1&quot;&gt;AI 시각화 이미지&lt;/h3&gt;
407:                     &lt;div className=&quot;relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-white/10 group shadow-[0_0_30px_rgba(139,92,246,0.15)]&quot;&gt;
408:                       &lt;Image 
409:                         key={imageRetryCount}
410:                         src={resultData.image_url} 
411:                         alt=&quot;AI가 생성한 꿈 이미지&quot; 
412:                         fill 
413:                         unoptimized={true}
414:                         onError={() =&gt; {
415:                           if (imageRetryCount &lt; 3) {
416:                             setTimeout(() =&gt; setImageRetryCount(prev =&gt; prev + 1), 1500);
417:                           }
418:                         }}
419:                         className=&quot;object-cover transition-transform duration-700 group-hover:scale-105&quot;
