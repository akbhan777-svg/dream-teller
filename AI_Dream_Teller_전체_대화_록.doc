14:   /시스템\s*프롬프트/i,
15:   /지시문(을|\s)*출력/i,
16:   /이전\s*지시(사항|\s)*무시/i,
17:   /규칙(을|\s)*무시/i,
18:   /모드\s*변경/i,
19: ];
20: 
21: // 극단적 유해어 및 NSFW 키워드 (정제용)
22: const HARMFUL_KEYWORDS = [
23:   /자살/g,
24:   /살해/g,
25:   /테러/g,
26:   /마약/g,
27: ];
28: 
29: /**
30:  * 프롬프트 인젝션 시도 여부를 탐지합니다.
31:  */
32: export function checkPromptInjection(text: string): { isInjected: boolean; reason?: string } {
33:   if (!text) return { isInjected: false };
34: 
35:   for (const pattern of PROMPT_INJECTION_PATTERNS) {
36:     if (pattern.test(text)) {
37:       return {
38:         isInjected: true,
39:         reason: `보안 지침 위반 (프롬프트 인젝션 패턴 감지: ${pattern.source})`,
40:       };
41:     }
42:   }
43: 
44:   return { isInjected: false };
45: }
46: 
47: /**
48:  * 유해어 및 NSFW 표현을 정제합니다.
49:  */
50: export function sanitizeHarmfulContent(text: string): string {
51:   if (!text) return &quot;&quot;;
52:   let sanitized = text;
53: 
54:   for (const keyword of HARMFUL_KEYWORDS) {
55:     sanitized = sanitized.replace(keyword, &quot;***&quot;);
56:   }
57: 
58:   return sanitized;
59: }
60: 
61: /**
62:  * 해몽 프롬프트 전체 검증 및 정제를 수행합니다.
63:  */
64: export function validateAndSanitizeDreamPrompt(text: string): {
65:   isValid: boolean;
66:   sanitizedText: string;
67:   error?: string;
68: } {
69:   const injectionCheck = checkPromptInjection(text);
70:   if (injectionCheck.isInjected) {
71:     return {
72:       isValid: false,
73:       sanitizedText: &quot;&quot;,
74:       error: &quot;악의적인 프롬프트 인젝션 시도가 탐지되어 요청이 거부되었습니다.&quot;,
75:     };
76:   }
77: 
78:   const sanitized = sanitizeHarmfulContent(text);
79:   return {
80:     isValid: true,
81:     sanitizedText: sanitized,
82:   };
83: }
