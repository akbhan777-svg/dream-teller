17: );
18: interface DreamHistoryItem {
19:   id: string;
20:   orderId: string;
21:   title: string;
22:   date: Date;
23:   expert: string;
24:   hasImage: boolean;
25:   imageUrl?: string;
26:   status: &quot;completed&quot; | &quot;analyzing&quot;;
27: }
28: 
29: interface PurchaseHistoryItem {
30:   id: string;
31:   itemName: string;
32:   price: number;
33:   date: string;
34:   status: string;
35: }
36: 
37: export default function MyPageClient() {
38:   const router = useRouter();
39:   const supabase = createClient();
40:   
41:   const [nickname, setNickname] = useState(&quot;로딩 중...&quot;);
42:   const [isEditing, setIsEditing] = useState(false);
43:   const [editValue, setEditValue] = useState(&quot;&quot;);
44:   const [userRole, setUserRole] = useState&lt;string&gt;(&quot;user&quot;);
45:   const [remainingPasses, setRemainingPasses] = useState(0);
46:   const [email, setEmail] = useState(&quot;&quot;);
47:   const [loginProvider, setLoginProvider] = useState&lt;&quot;google&quot; | &quot;kakao&quot;&gt;(&quot;google&quot;);
48:   const [isVerifyModalOpen, setIsVerifyModalOpen] = useState(false);
49:   const [loadingProfile, setLoadingProfile] = useState(true);
50:   
51:   // DB에서 불러온 실제 데이터 State
52:   const [purchaseHistory, setPurchaseHistory] = useState&lt;PurchaseHistoryItem[]&gt;([]);
53:   const [dreamHistory, setDreamHistory] = useState&lt;DreamHistoryItem[]&gt;([]);
54:   
55:   // 로그아웃 커스텀 모달 상태
56:   const [showLogoutModal, setShowLogoutModal] = useState(false);
57:   const [isLoggingOut, setIsLoggingOut] = useState(false);
58:   
59:   // 페이지네이션용 노출 개수 상태 (기본 3개씩 노출)
60:   const [visibleDreams, setVisibleDreams] = useState(3);
61:   const [visiblePurchases, setVisiblePurchases] = useState(3);
62:   const [selectedDate, setSelectedDate] = useState&lt;Date | undefined&gt;(undefined);
63: 
64:   const fetchProfile = useCallback(async () =&gt; {
65:     try {
66:       const { data: { user } } = await supabase.auth.getUser();
67:       if (!user) {
68:         router.replace(&quot;/guest-login&quot;);
69:         return;
70:       }
71: 
72:       // 1. 유저 프로필 정보 조회
73:       const { data: profile, error } = await supabase
74:         .from(&quot;users&quot;)
75:         .select(&quot;*&quot;)
76:         .eq(&quot;id&quot;, user.id)
77:         .single();
78: 
79:       if (error) throw error;
80: 
81:       if (profile) {
82:         const userProf = profile as {
83:           nickname?: string;
84:           email?: string;
85:           provider?: &quot;google&quot; | &quot;kakao&quot;;
86:           role?: string;
87:           remaining_interprets?: number;
88:         };
89:         setNickname(userProf.nickname || &quot;사용자&quot;);
90:         setEditValue(userProf.nickname || &quot;사용자&quot;);
91:         setEmail(userProf.email || &quot;&quot;);
92:         setLoginProvider((userProf.provider as &quot;google&quot; | &quot;kakao&quot;) || &quot;google&quot;);
93:         setUserRole(userProf.role || &quot;user&quot;);
94:         setRemainingPasses(userProf.remaining_interprets || 0);
95:       }
96: 
97:       // 2. 실제 DB orders &amp; dream_results 조회
98:       const { data: ordersData, error: ordersError } = await (supabase
99:         .from(&quot;orders&quot;) as any)
100:         .select(`
101:           id,
102:           order_number,
103:           order_type,
104:           total_amount,
105:           payment_status,
106:           expert_field,
107:           dream_content,
108:           includes_image,
109:           created_at,
110:           dream_results (
111:             id,
112:             analysis_status,
113:             image_url,
114:             created_at
115:           )
116:         `)
117:         .eq(&quot;user_id&quot;, user.id)
118:         .order(&quot;created_at&quot;, { ascending: false });
119: 
120:       if (!ordersError &amp;&amp; ordersData) {
121:         // 결제 내역 바인딩
122:         const mappedPurchases: PurchaseHistoryItem[] = ordersData.map((order: any) =&gt; {
123:           let itemName = &quot;1회 해석권 (단판)&quot;;
124:           if (order.order_type === &quot;pass_charge_5&quot;) itemName = &quot;5회 해석권 (다회권)&quot;;
125:           else if (order.order_type === &quot;pass_charge_10&quot;) itemName = &quot;10회 해석권 (다회권)&quot;;
126:           else if (order.order_type === &quot;pass_use&quot;) itemName = &quot;보유 잔여 횟수 사용&quot;;
127:           else if (order.includes_image) itemName = &quot;1회 해석권 (단판 + AI 이미지)&quot;;
128: 
129:           let statusText = &quot;결제 대기&quot;;
130:           if (order.payment_status === &quot;paid&quot;) statusText = &quot;결제 완료&quot;;
131:           else if (order.payment_status === &quot;failed&quot;) statusText = &quot;결제 실패&quot;;
132:           else if (order.payment_status === &quot;refunded&quot;) statusText = &quot;환불 완료&quot;;
133: 
134:           return {
135:             id: order.id,
136:             itemName,
137:             price: order.total_amount || 0,
138:             date: new Date(order.created_at).toLocaleString(&quot;ko-KR&quot;, {
139:               year: &quot;numeric&quot;,
140:               month: &quot;2-digit&quot;,
141:               day: &quot;2-digit&quot;,
142:               hour: &quot;2-digit&quot;,
143:               minute: &quot;2-digit&quot;,
144:             }),
145:             status: statusText,
146:           };
147:         });
148:         setPurchaseHistory(mappedPurchases);
149: 
150:         // 꿈 해석 내역 바인딩
151:         const mappedDreams: DreamHistoryItem[] = [];
152:         const nowTime = new Date().getTime();
153: 
154:         ordersData.forEach((order: any) =&gt; {
155:           const hasDreamRequest = Boolean(order.dream_content &amp;&amp; order.dream_content.trim().length &gt; 0);
156:           const isDreamOrderType = order.order_type === &quot;single_interpretation&quot; || order.order_type === &quot;pass_use&quot; || hasDreamRequest;
157: 
158:           if (order.payment_status === &quot;paid&quot; &amp;&amp; isDreamOrderType) {
159:             const resultObj = Array.isArray(order.dream_results) 
160:               ? order.dream_results[0] 
161:               : order.dream_results;
162: 
163:             const isCompleted = resultObj &amp;&amp; resultObj.analysis_status === &quot;completed&quot;;
164:             
165:             const orderTime = new Date(order.created_at).getTime();
166:             const isRecent = nowTime - orderTime &lt; 30 * 60 * 1000;
167:             const isAnalyzing = !isCompleted &amp;&amp; isRecent;
168: 
169:             const titleSnippet = order.dream_content
170:               ? order.dream_content.length &gt; 25
171:                 ? order.dream_content.substring(0, 25) + &quot;...&quot;
172:                 : order.dream_content
173:               : &quot;꿈 해몽 요청&quot;;
174: 
175:             mappedDreams.push({
176:               id: resultObj?.id || order.id,
177:               orderId: order.order_number || order.id,
178:               title: isCompleted 
179:                 ? `[해몽 완료] ${titleSnippet}` 
180:                 : isAnalyzing 
181:                   ? `[AI 분석 진행 중] ${titleSnippet}`
182:                   : `[해몽 리포트] ${titleSnippet}`,
183:               date: new Date(order.created_at),
184:               expert: order.expert_field || &quot;freud&quot;,
185:               hasImage: Boolean(order.includes_image),
186:               imageUrl: resultObj?.image_url,
187:               status: isAnalyzing ? &quot;analyzing&quot; : &quot;completed&quot;,
188:             });
189:           }
190:         });
191: 
192:         setDreamHistory(mappedDreams);
193:       }
194:     } catch (err) {
195:       console.error(&quot;프로필 및 주문 내역 획득 실패:&quot;, err);
196:     } finally {
197:       setLoadingProfile(false);
198:     }
199:   }, [supabase, router]);
200: 
201:   useEffect(() =&gt; {
202:     fetchProfile();
203:   }, [fetchProfile]);
204: 
205:   // 분석 진행 중인 해몽이 존재하는 경우 3초 간격으로 실시간 상태 자동 폴링
206:   useEffect(() =&gt; {
207:     const hasAnalyzing = dreamHistory.some((item) =&gt; item.status === &quot;analyzing&quot;);
208:     if (!hasAnalyzing) return;
209: 
210:     const timer = setInterval(() =&gt; {
211:       fetchProfile();
212:     }, 3000);
213: 
214:     return () =&gt; clearInterval(timer);
215:   }, [dreamHistory, fetchProfile]);
216: 
217:   // 캘린더 연동용 날짜 배열
218:   const highlightedDates = dreamHistory.map((item) =&gt; item.date);
219: 
220:   const [isSaving, setIsSaving] = useState(false);
221: 
222:   const handleSaveNickname = async () =&gt; {
223:     if (!editValue.trim()) return;
224:     setIsSaving(true);
225: 
226:     try {
227:       const response = await fetch(&quot;/api/users/me&quot;, {
228:         method: &quot;PATCH&quot;,
229:         headers: {
230:           &quot;Content-Type&quot;: &quot;application/json&quot;,
231:         },
232:         body: JSON.stringify({ nickname: editValue }),
233:       });
234: 
235:       const data = await response.json();
236:       if (!response.ok) {
237:         throw new Error(data.error || &quot;닉네임 업데이트 실패&quot;);
238:       }
239: 
240:       setNickname(editValue);
241:       setIsEditing(false);
242:     } catch (error) {
243:       console.error(&quot;닉네임 변경 실패:&quot;, error);
244:       alert(&quot;닉네임을 변경하는 도중 오류가 발생했습니다. 다시 시도해 주세요.&quot;);
245:     } finally {
246:       setIsSaving(false);
247:     }
248:   };
249: 
250:   const handleCancelEdit = () =&gt; {
251:     setEditValue(nickname);
252:     setIsEditing(false);
253:   };
254: 
255:   const handleDateClick = (date: Date) =&gt; {
256:     // 이미 선택된 날짜를 다시 클릭하면 필터 해제
257:     if (selectedDate &amp;&amp; date.getTime() === selectedDate.getTime()) {
258:       setSelectedDate(undefined);
259:     } else {
260:       setSelectedDate(date);
261:     }
262:   };
263: 
264:   const handleLogout = () =&gt; {
265:     setShowLogoutModal(true);
266:   };
267: 
268:   if (loadingProfile) {
269:     return (
270:       &lt;div className=&quot;flex flex-col items-center justify-center min-h-[400px] text-slate-400&quot;&gt;
271:         &lt;Loader2 className=&quot;w-8 h-8 animate-spin text-dream-purple-light mb-4&quot; /&gt;
272:         &lt;p className=&quot;text-sm&quot;&gt;프로필 정보를 불러오는 중입니다...&lt;/p&gt;
273:       &lt;/div&gt;
274:     );
275:   }
276: 
277:   const filteredDreamHistory = selectedDate
278:     ? dreamHistory.filter(
279:         (item) =&gt;
280:           item.date.getDate() === selectedDate.getDate() &amp;&amp;
281:           item.date.getMonth() === selectedDate.getMonth() &amp;&amp;
282:           item.date.getFullYear() === selectedDate.getFullYear()
283:       )
284:     : dreamHistory;
285: 
286:   return (
287:     &lt;div className=&quot;space-y-10&quot;&gt;
288:       
289:       {/* 관리자 전용 바로가기 배너 */}
290:       {userRole === &quot;admin&quot; &amp;&amp; (
291:         &lt;div className=&quot;p-5 rounded-3xl bg-gradient-to-r from-dream-purple/20 via-dream-blue/20 to-dream-pink/20 border border-dream-purple/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl&quot;&gt;
292:           &lt;div className=&quot;flex items-center gap-3.5&quot;&gt;
293:             &lt;div className=&quot;w-11 h-11 rounded-2xl bg-dream-purple/20 border border-dream-purple/40 flex items-center justify-center shrink-0&quot;&gt;
294:               &lt;ShieldCheck className=&quot;w-6 h-6 text-dream-purple-light&quot; /&gt;
295:             &lt;/div&gt;
296:             &lt;div&gt;
297:               &lt;h4 className=&quot;text-base font-bold text-white flex items-center gap-2&quot;&gt;
298:                 &lt;span&gt;관리자(Admin) 권한 계정&lt;/span&gt;
299:                 &lt;span className=&quot;text-[10px] bg-dream-purple/30 text-dream-purple-light border border-dream-purple/40 px-2 py-0.5 rounded-full font-mono&quot;&gt;ROLE: ADMIN&lt;/span&gt;
300:               &lt;/h4&gt;
301:               &lt;p className=&quot;text-xs text-slate-300 mt-0.5&quot;&gt;매출 대시보드, 전체 주문 내역 및 유저 관리 권한이 부여되어 있습니다.&lt;/p&gt;
302:             &lt;/div&gt;
303:           &lt;/div&gt;
304:           &lt;Button
305:             onClick={() =&gt; router.push(&quot;/admin&quot;)}
306:             className=&quot;w-full sm:w-auto bg-gradient-to-r from-dream-purple to-dream-pink hover:opacity-90 text-white font-bold text-xs px-5 py-3 rounded-2xl shadow-lg cursor-pointer shrink-0 flex items-center justify-center gap-1.5&quot;
307:           &gt;
308:             &lt;span&gt;관리자 대시보드 바로가기&lt;/span&gt;
309:             &lt;ChevronRight className=&quot;w-4 h-4&quot; /&gt;
310:           &lt;/Button&gt;
311:         &lt;/div&gt;
312:       )}
313: 
314:       {/* 1. 상단 프로필 및 잔여 횟수 카드 */}
315:       &lt;section className=&quot;relative&quot;&gt;
316:         &lt;div className=&quot;absolute -inset-1 bg-gradient-to-r from-dream-purple via-dream-blue to-dream-pink rounded-3xl blur-xl opacity-30 pointer-events-none&quot; /&gt;
317:         
318:         &lt;div className=&quot;relative bg-[#1c1c21]/80 backdrop-blur-2xl border border-white/10 rounded-3xl p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-8&quot;&gt;
319:           {/* 유저 기본 정보 */}
320:           &lt;div className=&quot;flex items-center gap-5&quot;&gt;
321:             &lt;div className=&quot;w-16 h-16 rounded-full bg-gradient-to-tr from-dream-purple to-dream-pink p-[2px] shadow-[0_0_20px_rgba(139,92,246,0.3)]&quot;&gt;
322:               &lt;div className=&quot;w-full h-full bg-[#15151a] rounded-full flex items-center justify-center&quot;&gt;
323:                 &lt;Moon className=&quot;w-8 h-8 text-dream-pink-light&quot; /&gt;
324:               &lt;/div&gt;
325:             &lt;/div&gt;
326: 
327:             &lt;div className=&quot;space-y-1.5&quot;&gt;
328:               {/* 이메일 및 로그인 방식 아이콘 + 관리자 인증 버튼 */}
329:               &lt;div className=&quot;flex items-center gap-2 text-xs text-slate-400 flex-wrap&quot;&gt;
330:                 &lt;span&gt;{email || &quot;로그인 계정 정보&quot;}&lt;/span&gt;
331:                 &lt;span className=&quot;w-1 h-1 bg-slate-600 rounded-full&quot; /&gt;
332:                 &lt;span className=&quot;capitalize&quot;&gt;{loginProvider} 계정&lt;/span&gt;
333:                 {userRole !== &quot;admin&quot; &amp;&amp; (
334:                   &lt;&gt;
335:                     &lt;span className=&quot;w-1 h-1 bg-slate-600 rounded-full&quot; /&gt;
336:                     &lt;button
337:                       onClick={() =&gt; setIsVerifyModalOpen(true)}
338:                       className=&quot;text-[11px] font-semibold text-dream-purple-light hover:underline flex items-center gap-1 bg-dream-purple/10 border border-dream-purple/30 px-2 py-0.5 rounded-md&quot;
339:                     &gt;
340:                       &lt;ShieldCheck className=&quot;w-3 h-3&quot; /&gt;
341:                       &lt;span&gt;관리자 본인 인증&lt;/span&gt;
342:                     &lt;/button&gt;
343:                   &lt;/&gt;
344:                 )}
345:               &lt;/div&gt;
346:               {/* 닉네임 수정 폼 */}
347:               &lt;div className=&quot;flex items-center gap-2&quot;&gt;
348:                 {isEditing ? (
349:                   &lt;div className=&quot;flex items-center gap-1&quot;&gt;
350:                     &lt;input
351:                       type=&quot;text&quot;
352:                       value={editValue}
353:                       onChange={(e) =&gt; setEditValue(e.target.value)}
354:                       maxLength={15}
355:                       className=&quot;bg-white/10 border border-white/20 rounded-lg px-2 py-0.5 text-white text-base focus:outline-none focus:border-dream-purple-light&quot;
356:                     /&gt;
357:                     &lt;button 
358:                       onClick={handleSaveNickname} 
359:                       disabled={isSaving}
360:                       className=&quot;p-1 hover:bg-white/10 rounded text-green-400 disabled:opacity-50&quot;
361:                     &gt;
362:                       {isSaving ? &lt;Loader2 className=&quot;w-4 h-4 animate-spin&quot; /&gt; : &lt;Check className=&quot;w-4 h-4&quot; /&gt;}
363:                     &lt;/button&gt;
364:                     &lt;button onClick={handleCancelEdit} className=&quot;p-1 hover:bg-white/10 rounded text-red-400&quot;&gt;
365:                       &lt;X className=&quot;w-4 h-4&quot; /&gt;
366:                     &lt;/button&gt;
367:                   &lt;/div&gt;
368:                 ) : (
369:                   &lt;&gt;
370:                     &lt;h2 className=&quot;text-xl font-bold text-white&quot;&gt;{nickname}&lt;/h2&gt;
371:                     &lt;button
372:                       onClick={() =&gt; setIsEditing(true)}
373:                       className=&quot;p-1 text-slate-400 hover:text-white hover:bg-white/5 rounded transition-colors&quot;
374:                     &gt;
375:                       &lt;Edit2 className=&quot;w-3.5 h-3.5&quot; /&gt;
376:                     &lt;/button&gt;
377:                   &lt;/&gt;
378:                 )}
379:               &lt;/div&gt;
380: 
381:               {/* 연동 소셜 및 이메일 */}
382:               &lt;div className=&quot;flex flex-col gap-2&quot;&gt;
383:                 &lt;div className=&quot;flex items-center gap-2 text-sm text-slate-400&quot;&gt;
384:                   {loginProvider === &quot;google&quot; ? (
385:                     &lt;span className=&quot;inline-flex items-center gap-1 bg-white/5 border border-white/10 px-2 py-0.5 rounded text-xs text-white&quot;&gt;
386:                       {/* Google G 로고 심플 SVG */}
387:                       &lt;svg className=&quot;w-3 h-3&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot;&gt;
388:                         &lt;path d=&quot;M12.24 10.285V14.4h6.887c-.648 2.41-2.519 4.114-5.244 4.114-3.415 0-6.195-2.78-6.195-6.195s2.78-6.195 6.195-6.195c1.485 0 2.89.525 3.99 1.485l3.12-3.12C18.91 1.77 15.68 1 12.24 1 5.92 1 1 5.92 1 12.24S5.92 23.48 12.24 23.48c6.12 0 11.24-4.4 11.24-11.24 0-.68-.08-1.36-.24-1.955H12.24z&quot;/&gt;
389:                       &lt;/svg&gt;
390:                       Google
391:                     &lt;/span&gt;
392:                   ) : (
393:                     &lt;span className=&quot;inline-flex items-center gap-1 bg-[#FEE500]/10 border border-[#FEE500]/25 px-2 py-0.5 rounded text-xs text-[#FEE500]&quot;&gt;
394:                       Kakao
395:                     &lt;/span&gt;
396:                   )}
397:                   &lt;span&gt;{email}&lt;/span&gt;
398:                 &lt;/div&gt;
399:                 
400:                 {/* 로그아웃 버튼 이메일 하단에 배치 */}
401:                 &lt;div className=&quot;pt-1&quot;&gt;
402:                   &lt;button
403:                     onClick={handleLogout}
404:                     className=&quot;inline-flex items-center gap-1.5 text-xs text-red-400/80 hover:text-red-400 hover:underline transition-all cursor-pointer&quot;
405:                   &gt;
406:                     &lt;LogOut className=&quot;w-3.5 h-3.5&quot; /&gt;
407:                     로그아웃
408:                   &lt;/button&gt;
409:                 &lt;/div&gt;
410:               &lt;/div&gt;
411:             &lt;/div&gt;
412:           &lt;/div&gt;
413: 
414:           {/* 잔여 횟수 박스 */}
415:           &lt;div className=&quot;bg-white/5 border border-white/10 rounded-2xl p-4 flex items-center gap-4 shadow-[inset_0_0_20px_rgba(255,255,255,0.02)] md:min-w-[240px]&quot;&gt;
416:             &lt;div className=&quot;p-3 bg-dream-pink/10 rounded-xl text-dream-pink-light&quot;&gt;
417:               &lt;Award className=&quot;w-6 h-6&quot; /&gt;
418:             &lt;/div&gt;
419:             &lt;div&gt;
420:               &lt;p className=&quot;text-xs text-slate-400&quot;&gt;잔여 꿈 해몽 횟수&lt;/p&gt;
421:               &lt;p className=&quot;text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-dream-pink to-dream-purple&quot;&gt;
422:                 {remainingPasses}회
423:               &lt;/p&gt;
424:             &lt;/div&gt;
425:           &lt;/div&gt;
426:         &lt;/div&gt;
427:       &lt;/section&gt;
428: 
429:       {/* 2. 무의식 캘린더 섹션 */}
430:       &lt;section className=&quot;grid md:grid-cols-12 gap-8 items-start&quot;&gt;
431:         
432:         {/* 캘린더 카드 */}
433:         &lt;div className=&quot;md:col-span-5 relative&quot;&gt;
434:           &lt;div className=&quot;absolute -inset-1 bg-dream-blue/20 blur-xl rounded-[2rem] opacity-40 pointer-events-none&quot; /&gt;
435:           &lt;div className=&quot;relative bg-[#1c1c21]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-6&quot;&gt;
436:             &lt;div className=&quot;flex items-center gap-2 mb-6&quot;&gt;
