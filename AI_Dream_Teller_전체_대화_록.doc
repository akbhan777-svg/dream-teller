472:                     {analysisContent.split(&apos;\n&apos;).map((line, idx) =&gt; {
473:                       if (!line.trim()) return null;
474:                       
475:                       // 헤딩 처리 (# ~ ####)
476:                       const headerMatch = line.match(/^(#{1,4})\s+(.+)/);
477:                       if (headerMatch) {
478:                         const level = headerMatch[1].length;
479:                         const text = headerMatch[2].replace(/\*/g, &apos;&apos;); // 제목 안의 불필요한 별표 제거
480:                         
481:                         if (level === 1) {
482:                           return &lt;h2 key={idx} className=&quot;text-2xl md:text-3xl font-black text-white mt-12 mb-6 border-b border-white/10 pb-4&quot;&gt;{text}&lt;/h2&gt;;
483:                         }
484:                         if (level === 2) {
485:                           return &lt;h3 key={idx} className=&quot;text-xl md:text-2xl font-bold text-dream-purple-light mt-10 mb-5 flex items-center gap-2&quot;&gt;&lt;span className=&quot;w-1.5 h-6 bg-dream-purple rounded-full inline-block&quot;&gt;&lt;/span&gt;{text}&lt;/h3&gt;;
486:                         }
487:                         return &lt;h4 key={idx} className=&quot;text-lg md:text-xl font-bold text-dream-pink-light mt-8 mb-4 flex items-center gap-2&quot;&gt;&lt;span className=&quot;w-1.5 h-5 bg-dream-pink rounded-full inline-block&quot;&gt;&lt;/span&gt;{text}&lt;/h4&gt;;
488:                       }
489: 
490:                       // 리스트(Bullet points) 처리 (- 또는 * 로 시작)
491:                       const listMatch = line.match(/^[-*]\s+(.+)/);
492:                       if (listMatch) {
493:                         const text = listMatch[1];
494:                         return (
495:                           &lt;div key={idx} className=&quot;flex items-start gap-3 text-slate-300 text-base md:text-lg leading-loose pl-2&quot;&gt;
496:                             &lt;span className=&quot;text-dream-purple-light mt-2&quot;&gt;•&lt;/span&gt;
497:                             &lt;span&gt;{text}&lt;/span&gt;
498:                           &lt;/div&gt;
499:                         );
500:                       }
501: 
502:                       // 굵은 텍스트(**text**) 처리 및 일반 텍스트 렌더링
503:                       const parts = line.split(/(\*\*.*?\*\*)/g);
504:                       return (
505:                         &lt;p key={idx} className=&quot;text-slate-300 leading-loose text-base md:text-lg break-keep&quot;&gt;
506:                           {parts.map((part, i) =&gt; {
507:                             if (part.startsWith(&apos;**&apos;) &amp;&amp; part.endsWith(&apos;**&apos;)) {
508:                               return &lt;strong key={i} className=&quot;text-white font-bold bg-white/5 px-1.5 py-0.5 rounded text-dream-blue-light&quot;&gt;{part.slice(2, -2)}&lt;/strong&gt;;
509:                             }
510:                             return part;
511:                           })}
512:                         &lt;/p&gt;
513:                       );
514:                     })}
515:                   &lt;/div&gt;
516:                 &lt;/section&gt;
